graph TD
  subgraph Edge
    O1[Org A Hospital - EU] --> E1[Enclave A]
    O2[Org B Bank - IN] --> E2[Enclave B]
    O3[Org C Clinic - US] --> E3[Enclave C]
    EI[Edge Inference Endpoint]
  end
  subgraph Federation
    E1 -->|gradients only| AGG[FedAvg Aggregator]
    E2 -->|gradients only| AGG
    E3 -->|gradients only| AGG
  end
  subgraph Crypto
    E1 & E2 & E3 --> PR[Proof Generator - hash commitments]
    PR --> VER[Proof Verifier]
    VER --> AGG
  end
  subgraph Governance
    DC[Data Contract Engine - GDPR DPDP HIPAA] --> AGG
    RB[Regulatory Bridge] --> DC
    AUD[Audit Log - hash chained]
  end
  subgraph Economics
    MK[Compute Marketplace - carbon aware] --> E1 & E2 & E3
    BIL[Billing Meter - cost tokens CO2]
  end
  AGG --> REG[Model Registry - signed, lineage]
  REG --> EI
  AGG --> AUD
  MK --> BIL
  subgraph Data
    PG[(Postgres)]
    RD[(Redis)]
  end
  AUD & REG & BIL --> PG
  AGG --> RD
  UI[Console UI - per-decision screens] --> AGG & DC & MK & REG & BIL & AUD
